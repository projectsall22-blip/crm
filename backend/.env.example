# ===== Oracle RMS London North CRM — Backend Environment Variables =====
# Copy this file to ".env" and fill in your values.

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database (MongoDB Atlas) ---
# Replace <user>:<password> and <cluster-url>/<db-name> with your Atlas credentials.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/crm?retryWrites=true&w=majority

# --- JWT ---
# Use a long random string (>= 32 chars) in production.
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_string
JWT_REFRESH_EXPIRES_IN=7d

# --- SMTP Email (Nodemailer) ---
# Supports Gmail SMTP, Microsoft 365, or any configurable provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Oracle RMS London North
SMTP_FROM_ADDRESS=noreply@yourcompany.com

# --- File Storage ---
# Local disk storage path for document uploads (kept outside web root).
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# --- App Defaults ---
DEFAULT_ADMIN_EMAIL=admin@brokerage.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
